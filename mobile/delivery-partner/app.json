{
  "expo": {
    "name": "SpiceRoute Delivery",
    "slug": "spiceroute-delivery-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1f2937"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spiceroute.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to track delivery location",
        "NSLocationAlwaysUsageDescription": "Required for background delivery tracking"
      }
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#1f2937" },
      "package": "com.spiceroute.delivery",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Allow SpiceRoute Delivery to use your location." }],
      ["expo-notifications", { "color": "#f97316" }]
    ]
  }
}
